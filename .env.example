GEMINI_API_KEY=

# Change this if your Google AI account uses another available Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# true = application works even without Gemini API key
# false = Gemini API key is required
DEMO_MODE=true

COMPANY_NAME=LegalEase
COMPANY_TAGLINE=AI-Powered Legal Document Generator
